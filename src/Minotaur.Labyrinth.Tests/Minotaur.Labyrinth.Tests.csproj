<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.6.6" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.6" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Minotaur.Labyrinth\Minotaur.Labyrinth.csproj" />
  </ItemGroup>

  <!--
    The shipped rule pack (rules/) and the corpus (tests/) travel with the
    test output so CorpusVerificationTests runs the real engine over the
    shipped rules both through the YAML directory and through a binary rule
    pack built by LabyrinthRulePack.
  -->
  <ItemGroup>
    <None Include="..\..\rules\**\*.*"
          CopyToOutputDirectory="PreserveNewest"
          Link="rules\%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="..\..\tests\**\*.*"
          CopyToOutputDirectory="PreserveNewest"
          Link="tests\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
